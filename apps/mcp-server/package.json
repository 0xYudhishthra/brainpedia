{
  "name": "@brainpedia/mcp-server",
  "version": "0.1.0",
  "description": "Brainpedia MCP server — invoked by Claude Desktop to compile vaults into Brains.",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "brainpedia-mcp": "dist/index.js"
  },
  "files": ["dist"],
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist .turbo"
  },
  "dependencies": {
    "@brainpedia/compute-0g": "workspace:*",
    "@brainpedia/ens": "workspace:*",
    "@brainpedia/obsidian-parser": "workspace:*",
    "@brainpedia/storage-0g": "workspace:*",
    "@ensdomains/ensjs": "^4.2.2",
    "@modelcontextprotocol/sdk": "^1.0.4",
    "ethers": "^6.13.4",
    "viem": "^2.21.55",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
