{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "scripts/setup/Dockerfile.axl-bootstrap"
  },
  "deploy": {
    "startCommand": "/usr/local/bin/axl -config /etc/axl/node-config.json",
    "restartPolicyType": "ALWAYS",
    "restartPolicyMaxRetries": 10
  }
}
